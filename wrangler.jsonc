{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bodhran",
  // Runs only for the paths in run_worker_first below: on Session Buddies' own
  // addresses Session Buddies is the site's root. Everything else is served as files.
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    // The whole folder is the site, as before; .assetsignore keeps back the
    // little that is not (git's own folder, this file, the worker, tools).
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/buddies/", "/sw.js"]
  }
  // The custom domains (sessionbuddies.shedworks.app, sessionbuddies.ceardlann.dev,
  // sessionbuddies.ceardlann.app)
  // are attached in the Cloudflare dashboard (Worker → Settings → Domains & Routes), not here.
}
